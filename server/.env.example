# Neon PostgreSQL connection string (use pooled endpoint)
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Comma-separated allowed origins for CORS
CORS_ORIGIN=http://localhost:5173

# Port (Render sets this automatically)
PORT=3001

# HMAC key used to sign auth tokens (generate with: openssl rand -hex 32).
# If unset a random key is used and all sessions are invalidated on restart.
AUTH_SECRET=

# Anthropic API key, used to generate Duel Companion dossiers.
# This is a separate credential from a Claude Pro/Max subscription — it
# requires Anthropic Console billing and is NOT included with Pro/Max.
ANTHROPIC_API_KEY=

# Free alternative to ANTHROPIC_API_KEY for generating Duel Companion dossiers.
# Get a no-cost key at https://aistudio.google.com/apikey (Google AI Studio's
# free tier). Used automatically when ANTHROPIC_API_KEY is unset, so this is
# the way to exercise real end-to-end dossier generation without any billing —
# see server/src/services/dossierService.smoke.test.ts.
GEMINI_API_KEY=

# Optional: pin the generation provider instead of auto-detecting from
# whichever *_API_KEY is set above. One of: anthropic | gemini
DOSSIER_PROVIDER=

# Optional: override the models used for 'quick' (fast, mid-duel) dossiers.
# Defaults: gemini-2.5-flash-lite / claude-haiku-4-5-20251001.
GEMINI_QUICK_MODEL=
DOSSIER_QUICK_MODEL=

# If both keys above are unset, dossier generation endpoints return a
# configuration error.

